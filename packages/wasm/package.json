{
  "name": "wasm-html-to-image-wasm",
  "version": "0.1.0",
  "description": "Single-WASM artifact + loader for wasm-html-to-image (Emscripten MODULARIZE/EXPORT_ES6, factory createHtmlToImageModule)",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./html-to-image.js": {
      "import": "./dist/html-to-image.js",
      "default": "./dist/html-to-image.js"
    }
  },
  "files": [
    "dist",
    "src"
  ],
  "license": "MIT",
  "scripts": {
    "build": "tsc -b"
  },
  "devDependencies": {
    "@types/node": "26.1.1",
    "typescript": "^5.9.2"
  }
}
