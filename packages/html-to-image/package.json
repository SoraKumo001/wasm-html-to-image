{
  "name": "wasm-html-to-image",
  "version": "0.1.2",
  "description": "HTML to image converter on a single unified WASM module",
  "type": "module",
  "main": "./dist/single.js",
  "types": "./dist/single.d.ts",
  "bin": {
    "wasm-html-to-image": "./dist/cli.js"
  },
  "author": "SoraKumo <info@croud.jp>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/SoraKumo001/wasm-html-to-image.git",
    "directory": "packages/html-to-image"
  },
  "homepage": "https://sorakumo001.github.io/wasm-html-to-image/master/docs/",
  "bugs": {
    "url": "https://github.com/SoraKumo001/wasm-html-to-image/issues"
  },
  "keywords": [
    "wasm",
    "webassembly",
    "html-to-image",
    "html2image",
    "skia",
    "litehtml",
    "image-optimization",
    "screenshot",
    "ogp",
    "avif",
    "webp",
    "pdf",
    "thumbhash",
    "cloudflare-workers",
    "edge-runtime"
  ],
  "engines": {
    "node": ">=20.0.0"
  },
  "scripts": {
    "build": "tsc -b && node scripts/compress-wasm.mjs && rolldown -c rolldown.config.js",
    "prepublishOnly": "npm run build",
    "test": "vitest run",
    "example:cli": "tsx src/cli.ts --help"
  },
  "exports": {
    ".": {
      "workerd": {
        "types": "./dist/workerd.d.ts",
        "import": "./dist/workerd.js"
      },
      "deno": {
        "types": "./dist/single.d.ts",
        "import": "./dist/single.js"
      },
      "single": {
        "types": "./dist/single.d.ts",
        "import": "./dist/single.js"
      },
      "types": "./dist/single.d.ts",
      "import": "./dist/single.js",
      "default": "./dist/single.js"
    },
    "./index": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./single": {
      "types": "./dist/single.d.ts",
      "import": "./dist/single.js",
      "default": "./dist/single.js"
    },
    "./workerd": {
      "workerd": {
        "types": "./dist/workerd.d.ts",
        "import": "./dist/workerd.js",
        "default": "./dist/workerd.js"
      },
      "edge-light": {
        "types": "./dist/edge-light.d.ts",
        "import": "./dist/edge-light.js",
        "default": "./dist/edge-light.js"
      },
      "types": "./dist/workerd.d.ts",
      "import": "./dist/workerd.js",
      "default": "./dist/workerd.js"
    },
    "./edge-light": {
      "types": "./dist/edge-light.d.ts",
      "import": "./dist/edge-light.js",
      "default": "./dist/edge-light.js"
    },
    "./workers": {
      "types": "./dist/workers.d.ts",
      "workerd": "./dist/workers-dummy.js",
      "node": "./dist/workers.js",
      "browser": "./dist/workers-parent.js",
      "default": "./dist/workers-dummy.js"
    },
    "./html-to-image.js": {
      "import": "./dist/html-to-image.js",
      "default": "./dist/html-to-image.js"
    },
    "./react": {
      "types": "./dist/react.d.ts",
      "import": "./dist/react.js"
    },
    "./preact": {
      "types": "./dist/preact.d.ts",
      "import": "./dist/preact.js"
    },
    "./tailwind": {
      "types": "./dist/tailwind.d.ts",
      "import": "./dist/tailwind.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "license": "MIT",
  "dependencies": {
    "commander": "15.0.0",
    "worker-lib": "2.2.1"
  },
  "peerDependencies": {
    "@unocss/core": "^66.6.5",
    "@unocss/preset-wind4": "^66.6.5",
    "preact": "^10.28.0",
    "preact-render-to-string": "^6.6.0",
    "react": "^16.8.0 || ^17.0.0 || ^18.0.0 || ^19.0.0",
    "react-dom": "^16.8.0 || ^17.0.0 || ^18.0.0 || ^19.0.0"
  },
  "peerDependenciesMeta": {
    "@unocss/core": {
      "optional": true
    },
    "@unocss/preset-wind4": {
      "optional": true
    },
    "preact": {
      "optional": true
    },
    "preact-render-to-string": {
      "optional": true
    },
    "react": {
      "optional": true
    },
    "react-dom": {
      "optional": true
    }
  },
  "devDependencies": {
    "@types/node": "26.4.1",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "rolldown": "^1.2.7",
    "tsx": "^4.23.13",
    "typescript": "^7.0.2",
    "vitest": "^5.0.0"
  }
}
