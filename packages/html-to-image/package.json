{
  "name": "wasm-html-to-image",
  "version": "0.1.0",
  "description": "HTML to image converter on a single unified WASM module",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "bin": {
    "wasm-html-to-image": "./dist/cli.js"
  },
  "scripts": {
    "build": "tsc -b",
    "test": "vitest run",
    "example:cli": "tsx src/cli.ts --help"
  },
  "exports": {
    ".": {
      "workerd": {
        "types": "./dist/workerd.d.ts",
        "import": "./dist/workerd.js"
      },
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./index": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./single": {
      "types": "./dist/single.d.ts",
      "import": "./dist/single.js",
      "default": "./dist/single.js"
    },
    "./workerd": {
      "types": "./dist/workerd.d.ts",
      "import": "./dist/workerd.js"
    },
    "./workers": {
      "types": "./dist/workers.d.ts",
      "workerd": "./dist/workers-dummy.js",
      "node": "./dist/workers.js",
      "browser": "./dist/workers.js",
      "default": "./dist/workers-dummy.js"
    },
    "./html-to-image.js": {
      "import": "./dist/html-to-image.js",
      "default": "./dist/html-to-image.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "license": "MIT",
  "dependencies": {
    "commander": "15.0.0",
    "worker-lib": "2.2.1"
  },
  "devDependencies": {
    "@types/node": "26.1.1",
    "tsx": "^4.23.1",
    "typescript": "^5.9.2",
    "vitest": "^4.1.10"
  }
}
